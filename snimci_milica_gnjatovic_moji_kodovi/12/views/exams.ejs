<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    
    <h1> Ispiti za <%= username %> </h1>

    <table>

        <tr>
            <th>Subject</th>
            <th>Date</th>
            <th>Grade</th>
        </tr>

        <% for (let exam of exams) { %>
                <tr>
                    <td> <%= exam.subject %> </td>
                    <td> <%= exam.date %> </td>
                    <td> <%= exam.grade %> </td>
                </tr>
        <% } %>

    </table>

</body>
</html>