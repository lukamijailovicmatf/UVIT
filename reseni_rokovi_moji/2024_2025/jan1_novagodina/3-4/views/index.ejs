<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Deda Mrazov spisak</title>
    <link rel="stylesheet" href="stil.css">
</head>

<body>

    <h1>Deda Mrazov spisak</h1>

    <!-- div za kutiju gde su Dobra deca i kutiju gde su Losa deca -->
    <div class="kutije">

        <div id="dobri">
            <h2 class="naslov-kutije"> Dobra deca </h2>
            <% for (let delo of dela) { %>
                <% if (delo.dobro) { %>
                    <div class="stavka">
                        <form method="get" action="/kid">
                            <span> <input type="text" value="<%= delo.ime %>" name="ime" hidden> </span>
                            <span> <input type="submit" value="<%= delo.ime %>"> </span>
                        </form>
                        <span> <%= delo.poeni %> </span>
                    </div>
                <% } %>
            <% } %>
            <!-- <div class="stavka"><span>Alisa</span><span>8</span></div>
            <div class="stavka"><span>Aurora</span><span>7</span></div>
            <div class="stavka"><span>Bambi</span><span>6</span></div>
            <div class="stavka"><span>Snezana</span><span>15</span></div> -->
        </div>
        
        <div id="losi">
            <h2 class="naslov-kutije"> Losa deca </h2>
            <% for (let delo of dela) { %>
                <% if (delo.poeni < 0) { %>
                    <div class="stavka">
                        <form method="get" action="/kid"> 
                            <span> <input type="text" value="<%= delo.ime %>" name="ime" hidden> </span>
                            <span> <input type="submit" value="<%= delo.ime %>"> </span>
                        </form>
                        <span> <%= delo.poeni %> </span>
                    </div>
                <% } %>
            <% } %>
            <!-- <div class="stavka"><span>Gaston</span><span>-7</span></div>
            <div class="stavka"><span>Hans</span><span>-7</span></div>
            <div class="stavka"><span>Kapetan Kuka</span><span>-7</span></div>
            <div class="stavka"><span>Kruela de Vil</span><span>-20</span></div>
            <div class="stavka"><span>Skar</span><span>-20</span></div>
            <div class="stavka"><span>Ursula</span><span>-17</span></div> -->
        </div>
    </div>

    <!-- div za formular -->
    <div id="formular">

        <h2 id="naslov-formulara"> Novo delo </h2>

        <form method="post" action="/unesi">

            <div class="polje-grupa">
                Dete:
                <input type="text" name="dete">
            </div>

            <div class="polje-potvrda">
                Delo:
                <input type="text" name="delo">
            </div>

            <div class="polje-grupa">
                Poeni:
                <input type="number" class="kontrola" name="poeni">
            </div>

            <input type="submit" value="unesi">

        </form>

    </div>
    
</body>

</html>